{
  "name": "aicde-ui",
  "version": "0.1.1",
  "description": "AICDE 風格的 React 元件庫：59 個元件、15 種主題、支援深色模式與 TypeScript",
  "author": "Asher Tee (https://github.com/zhijian090195)",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "aicde",
    "typescript",
    "dark-mode",
    "themes"
  ],
  "homepage": "https://zhijian090195.github.io/library/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhijian090195/library.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/zhijian090195/library/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run tokens:check && npm test && npm run typecheck && npm run build && npm run smoke",
    "tokens:check": "node ../tokens/build.mjs --check",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "5.1.1"
  }
}
